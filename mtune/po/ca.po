#: data/org.margo.Tune.desktop.in.in:2
#: data/org.margo.Tune.metainfo.xml.in.in:6
msgid "Tune"
msgstr "Tune"

#: data/org.margo.Tune.desktop.in.in:3
msgid "Music Player"
msgstr "Reproductor de música"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.margo.Tune.desktop.in.in:11
msgid "music;player;media;audio;playlist;"
msgstr "música;so;reproductor;multimèdia;àudio;llista de reproducció;"

#: data/org.margo.Tune.metainfo.xml.in.in:7
msgid "Plays music, and nothing else"
msgstr "Reprodueix música i res més"

#: data/org.margo.Tune.metainfo.xml.in.in:9
msgid ""
"Tune is a music player with no delusions of grandeur. If you just want to "
"play music available on your local system then Tune is the music player "
"you are looking for."
msgstr ""
"Tune és un reproductor de música sense deliris de grandesa. Si voleu "
"reproduir música disponible al vostre sistema local únicament, Tune és el "
"reproductor de música que busqueu."

#: data/org.margo.Tune.metainfo.xml.in.in:14
msgid "Current features:"
msgstr "Funcionalitats actuals:"

#: data/org.margo.Tune.metainfo.xml.in.in:16
msgid "adaptive UI"
msgstr "interfície d'usuari adaptativa"

#: data/org.margo.Tune.metainfo.xml.in.in:17
msgid "UI recoloring using the album art"
msgstr ""
"reacoloriment de la interfície d'usuari utilitzant la caràtula de l'àlbum"

#: data/org.margo.Tune.metainfo.xml.in.in:18
msgid "drag and drop support to queue songs"
msgstr ""
"implementació d'arrossegar i deixar anar per a posa a la cua les cançons"

#: data/org.margo.Tune.metainfo.xml.in.in:19
msgid "shuffle and repeat"
msgstr "aleatori i repetició"

#: data/org.margo.Tune.metainfo.xml.in.in:20
msgid "MPRIS integration"
msgstr "Integració MPRIS"

#: data/org.margo.Tune.metainfo.xml.in.in:48
msgid "Emmanuele Bassi"
msgstr "Emmanuele Bassi"

