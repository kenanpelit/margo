<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="mtune">
  <enum id="org.margo.Tune.ReplayGainMode">
    <value nick="album" value="0"/>
    <value nick="track" value="1"/>
    <value nick="off" value="2"/>
  </enum>
  <enum id="org.margo.Tune.ViewMode">
    <value nick="full" value="0"/>
    <value nick="mini" value="1"/>
    <value nick="strip" value="2"/>
  </enum>
  <schema id="org.margo.Tune" path="/org/margo/Tune/">
    <key name="window-width" type="i">
      <default>600</default>
    </key>
    <key name="window-height" type="i">
      <default>300</default>
    </key>
    <key name="enable-recoloring" type="b">
      <default>true</default>
    </key>
    <key name="replay-gain" enum="org.margo.Tune.ReplayGainMode">
      <default>'off'</default>
    </key>
    <key name="background-play" type="b">
      <default>true</default>
    </key>
    <key name="resume-uri" type="s">
      <default>''</default>
    </key>
    <key name="resume-position" type="t">
      <default>0</default>
    </key>
    <key name="playback-rate" type="d">
      <range min="0.5" max="2.0"/>
      <default>1.0</default>
    </key>
    <key name="view-mode" enum="org.margo.Tune.ViewMode">
      <default>'full'</default>
    </key>
  </schema>
</schemalist>
