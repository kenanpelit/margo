<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-maintained GtkBuilder XML (blueprint-compiler was dropped). -->
<interface>
  <requires lib="gtk" version="4.0"/>
  <menu id="primary_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">_Open Playlist…</attribute>
        <attribute name="action">queue.open-playlist</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Save Playlist As…</attribute>
        <attribute name="action">queue.save-playlist</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Tune</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
  <template class="TuneWindow" parent="AdwApplicationWindow">
    <property name="handle-menubar-accel">true</property>
    <property name="width-request">360</property>
    <property name="height-request">660</property>
    <property name="default-width">800</property>
    <property name="content">
      <object class="GtkWindowHandle">
        <child>
          <object class="DragOverlay" id="drag_overlay">
            <property name="title" translatable="yes">Drop a song to add it to the playlist</property>
            <property name="child">
              <object class="AdwToastOverlay" id="toast_overlay">
                <property name="child">
                  <object class="GtkStack" id="main_stack">
                    <property name="transition-type">1</property>
                    <!-- Each page sizes itself — otherwise the tall full
                         view forces the compact skins to 660px. -->
                    <property name="hhomogeneous">false</property>
                    <property name="vhomogeneous">false</property>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">initial-view</property>
                        <property name="child">
                          <object class="AdwToolbarView">
                            <child type="top">
                              <object class="AdwHeaderBar">
                                <property name="show-title">false</property>
                              </object>
                            </child>
                            <property name="content">
                              <object class="AdwClamp">
                                <property name="maximum-size">450</property>
                                <property name="vexpand">true</property>
                                <property name="valign">0</property>
                                <property name="child">
                                  <object class="AdwStatusPage" id="status_page">
                                    <property name="margin-start">12</property>
                                    <property name="margin-end">12</property>
                                    <property name="title">Tune</property>
                                    <property name="description" translatable="yes">Select a file or a folder, or drag files from your file manager to the application window to add songs to the playlist</property>
                                    <property name="child">
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="halign">3</property>
                                        <property name="homogeneous">true</property>
                                        <property name="spacing">12</property>
                                        <child>
                                          <object class="GtkButton" id="restore_playlist_button">
                                            <property name="label" translatable="yes">Restore Playlist</property>
                                            <property name="action-name">queue.restore-playlist</property>
                                            <style>
                                              <class name="suggested-action"/>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="add_folder_button">
                                            <property name="label" translatable="yes">Add Folder</property>
                                            <property name="action-name">queue.add-folder</property>
                                            <style>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="label" translatable="yes">Add Song</property>
                                            <property name="action-name">queue.add-song</property>
                                            <style>
                                              <class name="pill"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </property>
                                  </object>
                                </property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">main-view</property>
                        <property name="child">
                          <object class="AdwOverlaySplitView" id="split_view">
                            <property name="max-sidebar-width">330</property>
                            <property name="sidebar-width-fraction">0.4</property>
                            <property name="content">
                              <object class="AdwToolbarView">
                                <child type="top">
                                  <object class="AdwHeaderBar">
                                    <property name="show-title">false</property>
                                    <child type="start">
                                      <object class="GtkMenuButton">
                                        <property name="icon-name">open-menu-symbolic</property>
                                        <property name="menu-model">primary_menu</property>
                                        <property name="tooltip-text" translatable="yes">Main Menu</property>
                                        <property name="primary">true</property>
                                      </object>
                                    </child>
                                    <child type="end">
                                      <object class="GtkButton">
                                        <property name="icon-name">view-restore-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Compact view (Ctrl+M)</property>
                                        <property name="action-name">win.cycle-view</property>
                                        <style>
                                          <class name="flat"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child type="end">
                                      <object class="GtkMenuButton" id="speed_button">
                                        <property name="label">1.0×</property>
                                        <property name="tooltip-text" translatable="yes">Playback Speed</property>
                                        <property name="always-show-arrow">true</property>
                                        <style>
                                          <class name="flat"/>
                                          <class name="numeric"/>
                                        </style>
                                        <property name="popover">
                                          <object class="GtkPopover">
                                            <child>
                                              <object class="GtkBox">
                                                <property name="orientation">1</property>
                                                <property name="spacing">6</property>
                                                <property name="margin-start">6</property>
                                                <property name="margin-end">6</property>
                                                <property name="margin-top">6</property>
                                                <property name="margin-bottom">6</property>
                                                <child>
                                                  <object class="GtkScale" id="speed_scale">
                                                    <property name="width-request">200</property>
                                                    <property name="draw-value">false</property>
                                                    <property name="round-digits">2</property>
                                                    <property name="adjustment">
                                                      <object class="GtkAdjustment" id="speed_adjustment">
                                                        <property name="lower">0.5</property>
                                                        <property name="upper">2.0</property>
                                                        <property name="value">1.0</property>
                                                        <property name="step-increment">0.05</property>
                                                        <property name="page-increment">0.25</property>
                                                      </object>
                                                    </property>
                                                    <marks>
                                                      <mark value="0.5" position="bottom">0.5×</mark>
                                                      <mark value="1.0" position="bottom">1×</mark>
                                                      <mark value="1.5" position="bottom">1.5×</mark>
                                                      <mark value="2.0" position="bottom">2×</mark>
                                                    </marks>
                                                  </object>
                                                </child>
                                                <child>
                                                  <object class="GtkBox" id="speed_presets">
                                                    <property name="homogeneous">true</property>
                                                    <property name="spacing">4</property>
                                                    <style>
                                                      <class name="linked"/>
                                                    </style>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                                <property name="content">
                                  <object class="GtkBox" id="main_box">
                                    <property name="orientation">1</property>
                                    <property name="valign">3</property>
                                    <property name="vexpand">true</property>
                                    <property name="spacing">6</property>
                                    <style>
                                      <class name="main-box"/>
                                    </style>
                                    <child>
                                      <object class="TuneSongCover" id="song_cover"></object>
                                    </child>
                                    <child>
                                      <object class="GtkBox">
                                        <property name="orientation">1</property>
                                        <property name="spacing">2</property>
                                        <property name="width-request">256</property>
                                        <child>
                                          <object class="GtkBox">
                                            <property name="halign">3</property>
                                            <child>
                                              <object class="TuneWaveformView" id="waveform_view">
                                                <property name="can-focus">true</property>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkCenterBox">
                                            <property name="orientation">0</property>
                                            <property name="width-request">256</property>
                                            <property name="halign">3</property>
                                            <child type="start">
                                              <object class="GtkLabel" id="elapsed_label">
                                                <property name="label">0:00</property>
                                                <accessibility>
                                                  <property name="label" translatable="yes" context="a11y">Elapsed time</property>
                                                </accessibility>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                            <child type="end">
                                              <object class="GtkLabel" id="remaining_label">
                                                <property name="label">0:00</property>
                                                <accessibility>
                                                  <property name="label" translatable="yes" context="a11y">Remaining time</property>
                                                </accessibility>
                                                <style>
                                                  <class name="caption"/>
                                                  <class name="numeric"/>
                                                </style>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="TuneSongDetails" id="song_details"></object>
                                    </child>
                                    <child>
                                      <object class="TunePlaybackControl" id="playback_control">
                                        <property name="halign">center</property>
                                        <property name="margin-top">0</property>
                                        <property name="margin-bottom">24</property>
                                      </object>
                                    </child>
                                  </object>
                                </property>
                              </object>
                            </property>
                            <property name="sidebar">
                              <object class="TunePlaylistView" id="playlist_view"></object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkStackPage">
                        <property name="name">compact-view</property>
                        <property name="child">
                          <object class="GtkWindowHandle">
                            <property name="child">
                              <object class="GtkBox" id="compact_box">
                                <property name="orientation">1</property>
                                <property name="spacing">10</property>
                                <property name="valign">center</property>
                                <style>
                                  <class name="compact-view"/>
                                </style>

                                <!-- Row 1 — now playing + (mini) queue peek -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">12</property>
                                    <child>
                                      <object class="GtkImage" id="mini_cover">
                                        <property name="pixel-size">56</property>
                                        <property name="valign">center</property>
                                        <style>
                                          <class name="mini-cover"/>
                                        </style>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkBox" id="mini_meta_box">
                                        <property name="orientation">1</property>
                                        <property name="valign">center</property>
                                        <property name="hexpand">false</property>
                                        <property name="halign">start</property>
                                        <property name="spacing">1</property>
                                        <child>
                                          <object class="GtkLabel" id="mini_title">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">3</property>
                                            <property name="max-width-chars">26</property>
                                            <property name="width-chars">16</property>
                                            <style>
                                              <class name="mini-title"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="mini_artist">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">3</property>
                                            <property name="max-width-chars">36</property>
                                            <style>
                                              <class name="mini-artist"/>
                                              <class name="dim-label"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkLabel" id="mini_album">
                                            <property name="xalign">0</property>
                                            <property name="ellipsize">3</property>
                                            <property name="max-width-chars">36</property>
                                            <style>
                                              <class name="mini-album"/>
                                              <class name="dim-label"/>
                                              <class name="caption"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkSeparator" id="mini_queue_sep">
                                        <property name="orientation">1</property>
                                        <property name="margin-top">2</property>
                                        <property name="margin-bottom">2</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkScrolledWindow" id="mini_queue_scroll">
                                        <property name="hscrollbar-policy">2</property>
                                        <property name="hexpand">true</property>
                                        <property name="width-request">200</property>
                                        <property name="min-content-width">200</property>
                                        <property name="min-content-height">132</property>
                                        <property name="max-content-height">132</property>
                                        <property name="propagate-natural-height">false</property>
                                        <property name="propagate-natural-width">false</property>
                                        <style>
                                          <class name="mini-queue"/>
                                        </style>
                                        <property name="child">
                                          <object class="GtkListView" id="mini_queue">
                                            <property name="single-click-activate">true</property>
                                            <style>
                                              <class name="mini-queue-list"/>
                                            </style>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <!-- Row 2 — seek -->
                                <child>
                                  <object class="GtkBox">
                                    <property name="spacing">8</property>
                                    <property name="valign">center</property>
                                    <child>
                                      <object class="GtkScale" id="mini_seek">
                                        <property name="hexpand">true</property>
                                        <property name="draw-value">false</property>
                                        <property name="adjustment">
                                          <object class="GtkAdjustment" id="mini_seek_adjustment">
                                            <property name="lower">0</property>
                                            <property name="upper">1.0</property>
                                            <property name="step-increment">0.02</property>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="mini_time">
                                        <property name="label">0:00</property>
                                        <style>
                                          <class name="caption"/>
                                          <class name="numeric"/>
                                          <class name="dim-label"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>

                                <!-- Row 3 — controls -->
                                <child>
                                  <object class="GtkCenterBox">
                                    <property name="valign">center</property>
                                    <child type="start">
                                      <object class="GtkBox">
                                        <property name="spacing">2</property>
                                        <child>
                                          <object class="GtkButton" id="view_cycle_button">
                                            <property name="icon-name">view-restore-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Cycle view (Ctrl+M)</property>
                                            <property name="action-name">win.cycle-view</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkScaleButton" id="mini_volume">
                                            <property name="icons">audio-volume-muted-symbolic
audio-volume-high-symbolic
audio-volume-low-symbolic
audio-volume-medium-symbolic</property>
                                            <property name="value">1.0</property>
                                            <property name="adjustment">
                                              <object class="GtkAdjustment" id="mini_volume_adjustment">
                                                <property name="lower">0</property>
                                                <property name="upper">1.0</property>
                                                <property name="step-increment">0.05</property>
                                              </object>
                                            </property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child type="center">
                                      <object class="GtkBox">
                                        <property name="spacing">6</property>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">media-skip-backward-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Previous</property>
                                            <property name="action-name">win.previous</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton" id="mini_play_button">
                                            <property name="icon-name">media-playback-start-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Play / Pause</property>
                                            <property name="action-name">win.play</property>
                                            <style>
                                              <class name="suggested-action"/>
                                              <class name="circular"/>
                                              <class name="mini-play"/>
                                            </style>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkButton">
                                            <property name="icon-name">media-skip-forward-symbolic</property>
                                            <property name="tooltip-text" translatable="yes">Next</property>
                                            <property name="action-name">win.next</property>
                                            <style>
                                              <class name="flat"/>
                                              <class name="circular"/>
                                            </style>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child type="end">
                                      <object class="GtkButton">
                                        <property name="icon-name">window-close-symbolic</property>
                                        <property name="tooltip-text" translatable="yes">Close</property>
                                        <property name="action-name">window.close</property>
                                        <style>
                                          <class name="flat"/>
                                          <class name="circular"/>
                                        </style>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </child>
      </object>
    </property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 560sp</condition>
        <setter object="split_view" property="collapsed">true</setter>
      </object>
    </child>
  </template>
</interface>