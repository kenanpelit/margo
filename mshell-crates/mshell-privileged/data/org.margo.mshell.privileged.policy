<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!--
  mshell's privileged actions. Each one is a fixed subcommand of the
  root-owned /usr/lib/mshell/mshell-privileged helper, matched on
  exec.path + exec.argv1, so the polkit dialog names what root will do
  (the exact command line is in its details). The helper re-validates
  every argument itself (mshell-crates/mshell-privileged).
-->
<policyconfig>
  <vendor>margo</vendor>
  <vendor_url>https://github.com/kenanpelit/margo</vendor_url>

  <action id="org.margo.mshell.privileged.pacnew-install">
    <description>Replace a configuration file with its new default</description>
    <message>Authentication is required to replace a configuration file in /etc with the new version pacman left next to it (the old file is kept as .mshell-bak)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">pacnew-install</annotate>
  </action>

  <action id="org.margo.mshell.privileged.pacnew-merge">
    <description>Install a merged configuration file</description>
    <message>Authentication is required to replace a configuration file in /etc with the merge you reviewed (the old file is kept as .mshell-bak)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">pacnew-merge</annotate>
  </action>

  <action id="org.margo.mshell.privileged.pacnew-remove">
    <description>Delete a .pacnew / .pacsave file</description>
    <message>Authentication is required to delete a .pacnew, .pacsave or .pacorig file in /etc (the live configuration is not changed)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">pacnew-remove</annotate>
  </action>

  <action id="org.margo.mshell.privileged.kill">
    <description>End, pause or resume another user's process</description>
    <message>Authentication is required to end (TERM or KILL), pause (STOP) or resume (CONT) a process owned by another user</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">kill</annotate>
  </action>

  <action id="org.margo.mshell.privileged.smart-read">
    <description>Read drive health</description>
    <message>Authentication is required to read the drives' SMART health data (read-only)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">smart-read</annotate>
  </action>

  <action id="org.margo.mshell.privileged.smart-selftest">
    <description>Start a drive self-test</description>
    <message>Authentication is required to start a SMART self-test on a drive (run by the drive's firmware; the long test reads the whole drive)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">smart-selftest</annotate>
  </action>

  <action id="org.margo.mshell.privileged.fan-set">
    <description>Change the fan level</description>
    <message>Authentication is required to change the ThinkPad fan level</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">fan-set</annotate>
  </action>

  <action id="org.margo.mshell.privileged.charge-limit">
    <description>Change the battery charge limit</description>
    <message>Authentication is required to change the battery charge limit (the level at which charging stops)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">charge-limit</annotate>
  </action>

  <action id="org.margo.mshell.privileged.logind-dropin">
    <description>Change the power button and lid actions</description>
    <message>Authentication is required to change what the power button and closing the lid do (/etc/systemd/logind.conf.d/99-margo.conf)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">logind-dropin</annotate>
  </action>

  <action id="org.margo.mshell.privileged.upgrade">
    <description>Upgrade the system</description>
    <message>Authentication is required to upgrade the system from the official repositories (pacman -Syu)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">upgrade</annotate>
  </action>

  <action id="org.margo.mshell.privileged.rollback">
    <description>Roll a package back</description>
    <message>Authentication is required to reinstall an earlier version of a package from the pacman cache (pacman -U)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">rollback</annotate>
  </action>

  <action id="org.margo.mshell.privileged.boot-next">
    <description>Choose the next boot entry</description>
    <message>Authentication is required to choose which UEFI boot entry the next boot starts (BootNext, one boot only; the boot order is not changed)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">boot-next</annotate>
  </action>

  <action id="org.margo.mshell.privileged.led-set">
    <description>Switch a ThinkPad LED</description>
    <message>Authentication is required to switch a ThinkPad LED (such as the lid logo dot) on or off</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">led-set</annotate>
  </action>

  <action id="org.margo.mshell.privileged.ufw-status">
    <description>Read the firewall rules</description>
    <message>Authentication is required to read the UFW firewall's rule files (/etc/ufw/user.rules, user6.rules)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-status</annotate>
  </action>

  <action id="org.margo.mshell.privileged.ufw-switch">
    <description>Turn the firewall on or off</description>
    <message>Authentication is required to turn the UFW firewall on or off, or to reload its rules (ufw enable / disable / reload)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-switch</annotate>
  </action>

  <action id="org.margo.mshell.privileged.ufw-add">
    <description>Add a firewall rule</description>
    <message>Authentication is required to add a rule to the UFW firewall (ufw allow / deny / reject / limit)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-add</annotate>
  </action>

  <action id="org.margo.mshell.privileged.ufw-delete">
    <description>Remove a firewall rule</description>
    <message>Authentication is required to remove a rule from the UFW firewall (ufw delete)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-delete</annotate>
  </action>

  <action id="org.margo.mshell.privileged.ufw-unit">
    <description>Change the firewall service</description>
    <message>Authentication is required to start, stop, or enable / disable at boot the UFW firewall service (ufw.service)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/mshell/mshell-privileged</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">ufw-unit</annotate>
  </action>
</policyconfig>
